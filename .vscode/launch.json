{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (this repo)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extensions", "${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Extension (choose a repo)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${input:repo}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ],
  "inputs": [
    {
      "id": "repo",
      "type": "promptString",
      "description": "Absolute path of the repo to open in the Extension Development Host",
      "default": "D:\\personal"
    }
  ]
}
