{
  "name": "hesperus-vscode",
  "displayName": "Hesperus",
  "description": "A boundary linter and live map for repos agents write: what calls databases, the network, model APIs and other outside systems, what changed since you last looked, and what your policy forbids. Built by static analysis; no model draws or guesses edges.",
  "version": "0.1.0",
  "publisher": "pmghartman",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/pmghartman/hesperus"
  },
  "homepage": "https://github.com/pmghartman/hesperus#readme",
  "bugs": {
    "url": "https://github.com/pmghartman/hesperus/issues"
  },
  "keywords": [
    "architecture",
    "linter",
    "boundaries",
    "ai agents",
    "code review",
    "call graph",
    "data flow",
    "language server"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.hesperus/header.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hesperus",
          "title": "Hesperus",
          "icon": "media/graph.svg"
        }
      ]
    },
    "views": {
      "hesperus": [
        {
          "type": "webview",
          "id": "hesperus.graph",
          "name": "Graph"
        }
      ]
    },
    "commands": [
      {
        "command": "hesperus.openGraph",
        "title": "Hesperus: Open Graph"
      },
      {
        "command": "hesperus.refresh",
        "title": "Hesperus: Index",
        "icon": "$(refresh)"
      },
      {
        "command": "hesperus.accept",
        "title": "Hesperus: Accept All Changes as Reviewed"
      },
      {
        "command": "hesperus.policy",
        "title": "Hesperus: Open Boundary Policy"
      },
      {
        "command": "hesperus.explain",
        "title": "Hesperus: Explain the Flow"
      },
      {
        "command": "hesperus.connectClaudeCode",
        "title": "Hesperus: Connect Claude Code to the MCP Server"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hesperus.refresh",
          "when": "activeWebviewPanelId == hesperus",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Hesperus",
      "properties": {
        "hesperus.watch": {
          "type": "boolean",
          "default": true,
          "description": "Re-index and lint when source files change on disk, so an agent's edits show up as findings."
        },
        "hesperus.watchDelay": {
          "type": "number",
          "default": 1500,
          "minimum": 200,
          "description": "Milliseconds of quiet after the last change before re-indexing."
        },
        "hesperus.assistant": {
          "type": "string",
          "default": "",
          "description": "The AI assistant extension the sidebar's Ask button sends to, by id: copilot, claude-code, cline, roo, continue or kilo. Chosen from the sidebar's menu; empty means the first one installed."
        },
        "hesperus.explainWith": {
          "type": "string",
          "enum": [
            "auto",
            "editor",
            "claude-cli",
            "chat"
          ],
          "default": "auto",
          "enumDescriptions": [
            "The editor's own language models (Copilot Chat, or any extension that registers one), then the Claude Code CLI, then the chat assistant.",
            "Only the editor's language models.",
            "Only the Claude Code CLI (`claude -p`).",
            "Hand the question to the chat assistant and read the answer there; nothing is drawn."
          ],
          "description": "Where Explain sends the flow for a plain-language reading. The answer is checked against the chart before anything is drawn."
        },
        "hesperus.claudeCode": {
          "type": "boolean",
          "default": true,
          "description": "Register Hesperus's MCP server with Claude Code at user scope (claude mcp add -s user), so Claude Code can call hesperus_flow, hesperus_check and the rest in any repo it opens. Refreshed when the extension updates; nothing is written when Claude Code is not set up on the machine."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.hesperus/hesperus.json",
        "url": "./schema/policy.schema.json"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "hesperus.mcp",
        "label": "Hesperus"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/grammars.js && tsc -p .",
    "test": "npm run build && node scripts/smoke.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "check": "node out/cli.js check"
  },
  "dependencies": {
    "elkjs": "0.9.3",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-dart": "1.0.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "5.5.4"
  },
  "bin": {
    "hesperus": "./out/cli.js"
  }
}
