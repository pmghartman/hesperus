{
  "name": "hesperus-vscode",
  "displayName": "Hesperus",
  "description": "Static analysis for repos agents write: control flow from each entry point, the call graph, and every call that leaves the repo (database, network, model APIs, cloud, queues, filesystem, processes, environment). Served to agents over MCP. No model draws or guesses an edge.",
  "version": "0.1.0",
  "publisher": "pmghartman",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/pmghartman/hesperus"
  },
  "homepage": "https://github.com/pmghartman/hesperus#readme",
  "bugs": {
    "url": "https://github.com/pmghartman/hesperus/issues"
  },
  "keywords": [
    "static analysis",
    "control flow",
    "call graph",
    "boundaries",
    "linter",
    "mcp",
    "ai agents",
    "architecture"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.hesperus/header.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hesperus",
          "title": "Hesperus",
          "icon": "media/graph.svg"
        }
      ]
    },
    "views": {
      "hesperus": [
        {
          "type": "webview",
          "id": "hesperus.graph",
          "name": "Hesperus"
        }
      ]
    },
    "commands": [
      {
        "command": "hesperus.openGraph",
        "title": "Hesperus: Open View"
      },
      {
        "command": "hesperus.refresh",
        "title": "Hesperus: Index",
        "icon": "$(refresh)"
      },
      {
        "command": "hesperus.traceHere",
        "title": "Hesperus: Trace From Here",
        "icon": {
          "light": "media/trace-light.svg",
          "dark": "media/trace-dark.svg"
        }
      },
      {
        "command": "hesperus.connectClaudeCode",
        "title": "Hesperus: Register the MCP Server with Claude Code"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hesperus.traceHere",
          "when": "activeEditor == workbench.editors.files.textFileEditor && resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "hesperus.refresh",
          "when": "activeWebviewPanelId == hesperus",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Hesperus",
      "properties": {
        "hesperus.watch": {
          "type": "boolean",
          "default": true,
          "description": "Re-index the files that change on disk and re-lint, so an agent's edits show up as findings. Only after the repo has been indexed once."
        },
        "hesperus.watchDelay": {
          "type": "number",
          "default": 1500,
          "minimum": 200,
          "description": "Milliseconds of quiet after the last change before re-indexing."
        },
        "hesperus.claudeCode": {
          "type": "boolean",
          "default": true,
          "description": "Register Hesperus's MCP server with Claude Code at user scope (claude mcp add -s user), so Claude Code has hesperus_flow, hesperus_boundaries, the explain/impact prompts and the rest in any repo it opens. Refreshed when the extension updates; nothing is written when Claude Code is not set up on the machine."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "hesperus.mcp",
        "label": "Hesperus"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/grammars.js && tsc -p .",
    "test": "npm run build && node scripts/smoke.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "check": "node out/cli.js check"
  },
  "dependencies": {
    "elkjs": "0.9.3",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-dart": "1.0.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "5.5.4"
  },
  "bin": {
    "hesperus": "./out/cli.js"
  }
}
