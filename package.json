{
  "name": "hesperus-vscode",
  "displayName": "Hesperus",
  "description": "What happens when a request comes in: every entry point of a TypeScript repository, the code it reaches, and where each path leaves the program",
  "version": "0.1.0",
  "publisher": "pmghartman",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmghartman/hesperus"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:hesperus",
    "workspaceContains:**/*.hesp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "hesperus",
        "aliases": [
          "Hesperus",
          "hesperus"
        ],
        "extensions": [
          ".hesp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hesperus",
        "scopeName": "source.hesperus",
        "path": "./syntaxes/hesperus.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "hesperus.openViewer",
        "title": "Hesperus: Open Viewer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "hesperus.emit",
        "title": "Hesperus: Emit From Code",
        "icon": "$(sync)"
      },
      {
        "command": "hesperus.init",
        "title": "Hesperus: Create Intent From Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "hesperus.restartServer",
        "title": "Hesperus: Restart Language Server"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hesperus",
          "title": "Hesperus",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "hesperus": [
        {
          "id": "hesperus.status",
          "name": "Status"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hesperus.status",
        "contents": "Open a folder to describe it with Hesperus.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "hesperus.status",
        "contents": "This workspace has no Hesperus intent yet.\n[Create Intent From Code](command:hesperus.init)\nNames a component per source directory and every store and host found, then reads the flow of the code.\nOr write a .hesp file by hand: [see how](https://github.com/pmghartman/hesperus#use).",
        "when": "workbenchState != empty"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hesperus.openViewer",
          "when": "resourceLangId == hesperus",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "hesperus.emit",
          "when": "view == hesperus.status",
          "group": "navigation@1"
        },
        {
          "command": "hesperus.openViewer",
          "when": "view == hesperus.status",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Hesperus",
      "properties": {
        "hesperus.hespPath": {
          "type": "string",
          "default": "hesp",
          "description": "Path to the `hesp` command."
        },
        "hesperus.serverPath": {
          "type": "string",
          "default": "hesperus-lsp",
          "description": "Path to the `hesperus-lsp` language server."
        },
        "hesperus.extractorPath": {
          "type": "string",
          "default": "",
          "description": "Path to the hesperus-ts extractor entry (dist/cli.js) or command; empty uses $HESPERUS_TS or `hesperus-ts` on PATH."
        },
        "hesperus.intent": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative path of the intent master file; empty picks the master of the active .hesp file."
        },
        "hesperus.actualDir": {
          "type": "string",
          "default": ".hesperus/actual",
          "description": "Workspace-relative directory for flow.json; keep it under .hesperus, which ignores itself."
        },
        "hesperus.sourceRoot": {
          "type": "string",
          "default": "",
          "description": "Repository the actual files describe, for click-through to source; empty means the workspace folder."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --format=cjs --sourcemap",
    "build:webview": "esbuild src/webview/main.ts --bundle --outfile=media/viewer.js --format=iife --sourcemap",
    "build:extractor": "cd hesperus-ts && npm run build && cd .. && esbuild hesperus-ts/dist/cli.js --bundle --platform=node --format=cjs --outfile=extractor/cli.js --log-level=warning",
    "compile-tests": "tsc -p tsconfig.json",
    "test": "npm run build && npm run compile-tests && node --test \"out/test/*.test.js\"",
    "test:vscode": "npm run build && npm run compile-tests && node out/test/runVsCode.js",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
