{
  "name": "hesperus",
  "displayName": "Hesperus",
  "version": "0.1.7",
  "description": "A live map of what the repo reaches outside itself (databases, network, models, files, processes) in a pane beside the chat, re-drawn as the agent edits, with the same facts served to the agent over MCP.",
  "author": { "name": "pmghartman" },
  "homepage": "https://github.com/pmghartman/hesperus#readme",
  "repository": "https://github.com/pmghartman/hesperus",
  "license": "Apache-2.0",
  "keywords": ["architecture", "linter", "boundaries", "call graph", "code review", "static analysis"],
  "icon": "./.claude-plugin/icon.png",
  "types": "./types/index.d.ts",
  "mcpServers": {
    "hesperus": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hesperus.js", "mcp"]
    }
  }
}
