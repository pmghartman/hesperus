{
  "name": "hesperus-vscode",
  "displayName": "Hesperus",
  "description": "Zoomable graph of a repo's structure, calls, and data flow, built by static analysis. No model draws or guesses edges.",
  "version": "0.1.0",
  "publisher": "pmghartman",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/pmghartman/hesperus"
  },
  "homepage": "https://github.com/pmghartman/hesperus#readme",
  "bugs": {
    "url": "https://github.com/pmghartman/hesperus/issues"
  },
  "keywords": [
    "architecture",
    "call graph",
    "data flow",
    "code review",
    "language server"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hesperus",
          "title": "Hesperus",
          "icon": "media/graph.svg"
        }
      ]
    },
    "views": {
      "hesperus": [
        {
          "type": "webview",
          "id": "hesperus.graph",
          "name": "Graph"
        }
      ]
    },
    "commands": [
      {
        "command": "hesperus.openGraph",
        "title": "Hesperus: Open Graph"
      },
      {
        "command": "hesperus.refresh",
        "title": "Hesperus: Re-index",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hesperus.refresh",
          "when": "activeWebviewPanelId == hesperus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/grammars.js && tsc -p .",
    "test": "npm run build && node scripts/smoke.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "dependencies": {
    "elkjs": "0.9.3",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-dart": "1.0.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "5.5.4"
  }
}
