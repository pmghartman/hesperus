{
  "name": "hesperus-vscode",
  "displayName": "Hesperus",
  "description": "Zoomable graph of a repo's structure, calls, and data flow, built by static analysis. No model draws or guesses edges.",
  "version": "0.1.0",
  "publisher": "pmghartman",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/pmghartman/hesperus"
  },
  "homepage": "https://github.com/pmghartman/hesperus#readme",
  "bugs": {
    "url": "https://github.com/pmghartman/hesperus/issues"
  },
  "keywords": [
    "architecture",
    "call graph",
    "data flow",
    "code review",
    "scip"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hesperus",
          "title": "Hesperus",
          "icon": "media/graph.svg"
        }
      ]
    },
    "views": {
      "hesperus": [
        {
          "type": "webview",
          "id": "hesperus.graph",
          "name": "Graph"
        }
      ]
    },
    "commands": [
      {
        "command": "hesperus.openGraph",
        "title": "Hesperus: Open Graph"
      },
      {
        "command": "hesperus.refresh",
        "title": "Hesperus: Re-index",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hesperus.refresh",
          "when": "activeWebviewPanelId == hesperus",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Hesperus",
      "properties": {
        "hesperus.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to a hesperus CLI to use instead of the one bundled with the extension. Leave empty to use the bundled CLI."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test \"out/**/*.test.js\"",
    "vscode:prepublish": "tsc -p .",
    "package": "vsce package"
  },
  "dependencies": {
    "elkjs": "0.9.3"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "typescript": "5.5.4"
  }
}
