{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hesperus graph",
  "description": "Schema version 2. Mirrored by vscode/src/core/ir.ts; change both together.",
  "type": "object",
  "required": ["schema_version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["start_line", "start_col", "end_line", "end_col"],
      "additionalProperties": false,
      "properties": {
        "start_line": { "type": "integer" },
        "start_col": { "type": "integer" },
        "end_line": { "type": "integer" },
        "end_col": { "type": "integer" }
      }
    },
    "site": {
      "type": "object",
      "required": ["path", "range"],
      "additionalProperties": false,
      "properties": { "path": { "type": "string" }, "range": { "$ref": "#/$defs/range" } }
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["repo", "directory", "package", "file", "type", "function", "method", "field", "variable", "external_package", "external", "unresolved"] },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "range": { "$ref": "#/$defs/range" },
        "signature": { "type": "string" },
        "doc": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "kind", "provenance"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": { "enum": ["contains", "call", "override", "flow"] },
        "provenance": { "enum": ["resolved", "may", "unresolved"] },
        "label": { "type": "string" },
        "site": { "$ref": "#/$defs/site" }
      }
    }
  }
}
